<?xml version="1.0" encoding="utf-8"?>
<!--
   nw   n   ne
   w    c    e
   sw   s   se

&gt:>
&lt:<

<key c="8" n="⁸" e="🕛:'shell:date \'%H:%M \''" s="₈" w="🈷️:'shell:date \'#### %Y%m%d%a\''" />
-->
<keyboard name="T1D" script="latin">
  <row><!-- row1 -->
    <key c="home" n=":" />
    <key c="/" ne="A:'&gt;A'" e="B:'&gt;B'" se="ᴛ:'&lt;T'" sw="ᴛ:'&gt;T'" w="B:'&lt;B'" nw="A:'&lt;A'" />
    <key c="1" n="¹" ne="ᵇ:b" e="N" se="d" s="₁" sw="c" w="H" nw="ª:a" />
    <key c="2" n="²" ne="ᶠ:f" e="½" se="ₕ:h" s="₂" sw="ɢ:g" w="R" nw="ᵉ:e" />
    <key c="3" n="³" ne="ʲ:j" e="T" se="ₗ:l" s="₃" sw="ₖ:k" w="I" nw="ⁱ:i" />
    <key c="down" nw="(" n="():'()',left" ne=")" s="[]:'[]',left" />
    <key c="space" n="copy" s="paste" />
  </row>
  <row><!-- row2 -->
    <key c="up" />
    <key c="left" n="(AC):'(AC)'" e="内:'&gt;内'" s="mg/dL:'mg/dL',left,right" w="内:'&lt;内'" />
    <key c="4" n="⁴" ne="ⁿ:n" e="T" se="C" s="₄" w="B" nw="ᵐ:m" />
    <key c="5" n="⁵" ne="ᵖ:p" e="內" se="ᵣ:r" s="₅" sw="q:q" w="鹽" nw="º:o" />
    <key c="6" n="⁶" ne="ᵗ:t" e="⁺" se="ᵥ:v" s="₆" sw="ᵤ:u" w="⁻" nw="ˢ:s" />
    <key c="right" n="-{}:end,right,'    -`{}`',right,enter,left,left,left,left" e="&gt;" s="\n:end,right,enter,up" w="&lt;" />
    <key c="end" />
  </row>
  <row><!-- row3 -->
    <key c="shift" role="action" ne="loc capslock" />
    <key c="0" n="⁰" e="selectAll" s="₀" />
    <key c="7" n="⁷" ne="ˣ:x" e="end" se="z" s="₇" sw="y:y" w="home" nw="ʷ:w" />
    <key c="8" n="⁸" e="🕛:'{{HH:mm}}'" s="₈" w="🈷️:'#### {{yyyyMMddE}}',enter" />
    <key c="9" n="⁹" e="+" se="." s="₉" sw="," />
    <key c="backspace" role="action" />
    <key c="delete" role="action" n="redo" s="undo" />
  </row>
</keyboard>
